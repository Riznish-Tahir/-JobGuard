rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCompany(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200
             && data.status in ['legit', 'fake', 'under-review']
             && data.createdAt == request.time;
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidCompany(request.resource.data);
      allow update: if isSignedIn() && (
        // Only allow updating ratings or status if authorized
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalRatings', 'status'])
      );
    }

    match /companies/{companyId}/reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']));
      allow delete: if isOwner(resource.data.authorId);
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isOwner(resource.data.authorId);
    }
  }
}
